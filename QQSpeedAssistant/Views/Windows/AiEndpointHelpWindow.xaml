<ui:FluentWindow x:Class="QQSpeedAssistant.Views.Windows.AiEndpointHelpWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="接口地址和模型怎么填"
                 Width="1000"
                 Height="820"
                 MinWidth="880"
                 MinHeight="640"
                 Background="{StaticResource BgBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title=""
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <Grid Grid.Row="1" Margin="20,4,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="接口地址和模型怎么填" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           TextWrapping="Wrap"
                           Text="左边挑一套方案，右边点「一键填入设置」就把地址和模型写好了；也可以照三步手动抄。密钥得自己去官网拿一次，程序不代填。" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="286" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：方案列表 -->
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="可用方案（免费或本地）"
                                   Style="{StaticResource Muted}"
                                   Margin="6,4,0,8" />
                        <ListBox ItemsSource="{Binding Presets}"
                                 SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,7,6,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Background="{Binding BadgeBrush}"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                Margin="0,5,0,0"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Badge}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F1115" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 右：三步说明 -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,18" Margin="14,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedPreset.Name}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Background="{Binding SelectedPreset.BadgeBrush}"
                                        CornerRadius="4"
                                        Padding="7,2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedPreset.Badge}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="#0F1115" />
                                </Border>
                                <TextBlock Text="当前正在使用"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Visibility="{Binding IsInUse, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedPreset.Summary}"
                                       Style="{StaticResource Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0" />

                            <!-- 第 1 步 -->
                            <TextBlock Text="第 1 步 · 识别接口地址"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,18,0,8" />
                            <Border Background="{StaticResource InputBrush}"
                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedPreset.BaseUrl}"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Content="复制"
                                            Style="{StaticResource SmallButton}"
                                            Command="{Binding CopyBaseUrlCommand}" />
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Text="填到 /v1、/v4 这一层就行，程序会自动补 /chat/completions；多填了后面那截也认。" />

                            <!-- 第 2 步 -->
                            <TextBlock Text="第 2 步 · 接口密钥"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,18,0,8" />
                            <TextBlock Text="{Binding KeyStepHint}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding CanOpenKeyUrl, Converter={StaticResource BoolToVis}}">
                                <Button Content="去获取密钥"
                                        Command="{Binding OpenKeyUrlCommand}" />
                                <TextBlock Style="{StaticResource Muted}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Text="复制回来的那串粘到设置页的「接口密钥」里" />
                            </StackPanel>

                            <!-- 第 3 步 -->
                            <TextBlock Text="第 3 步 · 模型名"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,18,0,8" />
                            <ListBox ItemsSource="{Binding SelectedPreset.Models}"
                                     SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,5">
                                            <TextBlock Text="{Binding Id}"
                                                       FontFamily="Consolas"
                                                       FontSize="12.5" />
                                            <TextBlock Text="{Binding Remark}"
                                                       Style="{StaticResource Muted}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="0,7,0,0" FontSize="12">
                                <Run Text="已选模型：" Foreground="{StaticResource TextMutedBrush}" />
                                <Run Text="{Binding SelectedModel.Id, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}"
                                     FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Text="{Binding FallbackHint}" />

                            <!-- 注意事项 -->
                            <Border Background="#191D25"
                                    BorderBrush="{StaticResource WarnBrush}"
                                    BorderThickness="3,0,0,0"
                                    CornerRadius="6"
                                    Padding="12,9"
                                    Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="这套方案的坑"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource WarnBrush}" />
                                    <TextBlock Text="{Binding SelectedPreset.Note}"
                                               FontSize="12"
                                               Foreground="#C8CEDA"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 主按钮钉在卡片底栏：内容再长也不至于要滚到底才找得到 -->
                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,12,0,0"
                                Padding="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="一键填入设置"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="20,9"
                                            Command="{Binding ApplyCommand}" />
                                    <Button Content="复制模型名"
                                            Style="{StaticResource SmallButton}"
                                            Margin="8,0,0,0"
                                            Command="{Binding CopyModelCommand}" />
                                    <Button Content="打开官网核对"
                                            Style="{StaticResource SmallButton}"
                                            Margin="8,0,0,0"
                                            Command="{Binding OpenConsoleCommand}"
                                            Visibility="{Binding CanOpenConsole, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Muted}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"
                                           Text="填完回设置页点「测试验证码识别（先让验证码弹出来）」。看到 401 是密钥不对，404 是模型名不对，429 是免费额度用完了。" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="20,10,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}"
                       Style="{StaticResource Muted}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,16,0" />
            <Button Grid.Column="1"
                    Content="关闭"
                    Click="OnCloseClick"
                    VerticalAlignment="Center" />
        </Grid>
    </Grid>
</ui:FluentWindow>
