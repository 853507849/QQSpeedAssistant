<ui:FluentWindow x:Class="QQSpeedAssistant.Views.Windows.TemplateCaptureWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:QQSpeedAssistant.Views.Controls"
                 Title="模板采集"
                 Width="1120"
                 Height="760"
                 MinWidth="900"
                 MinHeight="620"
                 Background="{StaticResource BgBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title=""
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True" />

        <Grid Grid.Row="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="模板采集" Style="{StaticResource PageTitle}" />
            <TextBlock Text="抓取游戏画面后，拖拽框选要识别的按钮或图标，保存为模板；保存时会记录当前窗口宽度，运行时自动按比例缩放匹配"
                       Style="{StaticResource PageSubtitle}" />

            <Grid Margin="0,14,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="窗口" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                <controls:DropDownSelector Grid.Column="1"
                                           ItemsSource="{Binding Windows}"
                                           SelectedItem="{Binding SelectedWindow, Mode=TwoWay}" />
                <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshWindowsCommand}" Margin="8,0,0,0" />
                <Button Grid.Column="3" Content="抓取画面" Style="{StaticResource PrimaryButton}" Command="{Binding GrabCommand}" Margin="8,0,0,0" />

                <TextBlock Grid.Column="4" Text="模板名" Style="{StaticResource FieldLabel}" Margin="18,0,8,0" />
                <TextBox Grid.Column="5" Text="{Binding TemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="6" Content="保存框选" Command="{Binding SaveSelectionCommand}" Margin="8,0,0,0" IsEnabled="{Binding HasFrame, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#0B0D12"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid x:Name="PreviewHost"
                  ClipToBounds="True"
                  Background="#0B0D12"
                  MouseLeftButtonDown="OnPreviewMouseDown"
                  MouseMove="OnPreviewMouseMove"
                  MouseLeftButtonUp="OnPreviewMouseUp">
                <Image x:Name="PreviewImage"
                       Source="{Binding Preview, Mode=OneWay}"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
                <Canvas x:Name="SelectionLayer" Background="Transparent">
                    <Rectangle x:Name="SelectionRect"
                               Stroke="#3B82F6"
                               StrokeThickness="2"
                               Fill="#333B82F6"
                               Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status, Mode=OneWay}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="关闭" Click="OnCloseClick" />
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
