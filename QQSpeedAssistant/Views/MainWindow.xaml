<ui:FluentWindow x:Class="QQSpeedAssistant.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="QQ飞车任务助手"
                 Width="1200"
                 Height="800"
                 MinWidth="1040"
                 MinHeight="660"
                 Background="{StaticResource BgBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏：提供拖动、最小化、最大化与关闭 -->
        <ui:TitleBar Grid.Row="0"
                     Title=""
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True" />

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="234" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,14">
                    <TextBlock Text="QQ飞车任务助手" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle, Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,5,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Margin="20,0,20,18"
                           Style="{StaticResource Muted}"
                           Text="流程与模板需按本机客户端校准" />

                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph, Mode=OneWay}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15"
                                           Width="26"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title, Mode=OneWay}"
                                           FontSize="13.5"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 页面区域 -->
        <ContentControl Grid.Column="1" Content="{Binding SelectedNavigationItem.Page, Mode=OneWay}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
