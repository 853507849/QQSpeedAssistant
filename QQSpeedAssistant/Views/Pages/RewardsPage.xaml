<UserControl x:Class="QQSpeedAssistant.Views.Pages.RewardsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QQSpeedAssistant.Views.Controls">
    <Grid Margin="26,24,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="奖励截图" Style="{StaticResource PageTitle}" />
            <TextBlock Text="每个账号的奖励截图单独存放在 User/rewards/{账号} 目录下，完成玩法后自动保存"
                       Style="{StaticResource PageSubtitle}" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
                <controls:DropDownSelector Width="170"
                                           ItemsSource="{Binding Accounts}"
                                           SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" />
                <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="10,0,0,0" />
                <Button Content="打开奖励目录" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
                <Button Content="定位当前图片" Command="{Binding OpenSelectedCommand}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding SummaryText, Mode=OneWay}"
                           Style="{StaticResource Muted}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0">
                <ListBox ItemsSource="{Binding VisibleItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="216"
                                    Margin="0,0,10,10"
                                    Padding="8"
                                    Background="{StaticResource PanelAltBrush}"
                                    CornerRadius="8">
                                <StackPanel>
                                    <Border Background="#0B0D12" CornerRadius="6" Height="118">
                                        <Image Source="{Binding Thumbnail, Mode=OneWay}"
                                               Stretch="UniformToFill"
                                               SnapsToDevicePixels="True" />
                                    </Border>
                                    <TextBlock Text="{Binding Account, Mode=OneWay}"
                                               FontSize="12.5"
                                               Margin="0,8,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ModeName, Mode=OneWay}"
                                               Style="{StaticResource Muted}"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding CreatedText, Mode=OneWay}"
                                               Style="{StaticResource Muted}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="预览" Style="{StaticResource SectionTitle}" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding SelectedItem.FileName, Mode=OneWay}"
                               Style="{StaticResource Muted}"
                               Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <Border Background="#0B0D12" CornerRadius="8">
                        <Image Source="{Binding Preview, Mode=OneWay}" Stretch="Uniform" Margin="6" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
