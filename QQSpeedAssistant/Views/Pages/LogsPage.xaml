<UserControl x:Class="QQSpeedAssistant.Views.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,24,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="运行日志" Style="{StaticResource PageTitle}" />
            <TextBlock Text="同时写入 User/log 下的按天日志文件，便于事后排查"
                       Style="{StaticResource PageSubtitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
                <Button Content="清空显示" Command="{Binding ClearCommand}" />
                <Button Content="打开日志目录" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
                <Button Content="复制全部日志" Click="OnCopyAll" Margin="8,0,0,0"
                        ToolTip="把当前显示的所有日志按「时间 级别 来源 内容」复制到剪贴板，可直接粘到聊天窗口" />
                <TextBlock Text="{Binding SummaryText, Mode=OneWay}"
                           Style="{StaticResource Muted}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0" />
                <TextBlock Text="{Binding CopyHint, Mode=OneWay}"
                           Style="{StaticResource Muted}"
                           VerticalAlignment="Center"
                           Foreground="#4ADE80"
                           Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
            <ListBox x:Name="LogList"
                     ItemsSource="{Binding Logs}"
                     Background="Transparent"
                     BorderThickness="0"
                     PreviewMouseRightButtonDown="OnLogListRightButtonDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制这一条" Click="OnCopySelected" />
                        <MenuItem Header="复制全部日志" Click="OnCopyAll" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TimeText, Mode=OneWay}"
                                       Style="{StaticResource Muted}"
                                       FontFamily="Consolas" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LevelText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{Binding Level, Mode=OneWay, Converter={StaticResource LogLevelBrush}}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Source, Mode=OneWay}"
                                       Style="{StaticResource Muted}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Message, Mode=OneWay}"
                                       FontSize="12.5" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
