<UserControl x:Class="QQSpeedAssistant.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,24,26,24">

            <!-- 标题与操作 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="任务总览" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="多账号自动登录 · 按玩法设定局数 · 自动保存每个账号的奖励截图"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E2A44" CornerRadius="16" Padding="14,6" Margin="0,0,12,0">
                        <TextBlock Text="{Binding StateText, Mode=OneWay}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <Button Content="开始任务"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding CanStart, Mode=OneWay}"
                            Margin="0,0,8,0" />
                    <Button Content="停止"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanStop, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!-- 状态卡片 -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="当前账号" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding CurrentAccount, Mode=OneWay}"
                                   Style="{StaticResource BigValue}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="当前玩法" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding CurrentMode, Mode=OneWay}"
                                   Style="{StaticResource BigValue}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="运行进度" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding ProgressText, Mode=OneWay}"
                                   Style="{StaticResource BigValue}"
                                   FontSize="14"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="账号 / 任务" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding AccountInfo, Mode=OneWay}"
                                   Style="{StaticResource BigValue}"
                                   FontSize="14"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding TaskInfo, Mode=OneWay}"
                                   Style="{StaticResource Muted}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 计划与快捷入口 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,14">
                <StackPanel>
                    <TextBlock Text="本次计划" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ScheduleText, Mode=OneWay}" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding ShutdownText, Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Summary, Mode=OneWay}" Margin="0,10,0,0" FontSize="12.5" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="奖励目录" Command="{Binding OpenRewardFolderCommand}" />
                            <Button Content="流程目录" Command="{Binding OpenFlowFolderCommand}" Margin="8,0,0,0" />
                            <Button Content="模板目录" Command="{Binding OpenTemplateFolderCommand}" Margin="8,0,0,0" />
                            <Button Content="取消关机" Style="{StaticResource DangerButton}" Command="{Binding CancelShutdownCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 最近日志 -->
            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text="最近日志" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding RecentLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText, Mode=OneWay}"
                                               Style="{StaticResource Muted}"
                                               FontFamily="Consolas" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LevelText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{Binding Level, Mode=OneWay, Converter={StaticResource LogLevelBrush}}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Source, Mode=OneWay}"
                                               Style="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Message, Mode=OneWay}"
                                               FontSize="12.5" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="暂无日志" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentLogs.Count, Mode=OneWay}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
