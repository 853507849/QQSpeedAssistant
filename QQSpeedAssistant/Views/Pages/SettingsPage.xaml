<UserControl x:Class="QQSpeedAssistant.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部固定条：标题与保存按钮不跟着内容滚，改完随手就能存 -->
        <Border Grid.Row="0"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,18,26,12">
            <StackPanel>
                <TextBlock Text="运行设置" Style="{StaticResource PageTitle}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="立即保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                    <Button Content="用户目录" Command="{Binding OpenUserFolderCommand}" Margin="8,0,0,0" />
                    <Button Content="流程目录" Command="{Binding OpenFlowFolderCommand}" Margin="8,0,0,0" />
                    <Button Content="模板目录" Command="{Binding OpenTemplateFolderCommand}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                               Style="{StaticResource Muted}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,0">
            <StackPanel Margin="26,16,26,24">

                <TextBlock Text="所有修改会自动保存。号池并发、票完动作、定时下号、快速登录、开机自启与预设方案都在这里配置"
                           Style="{StaticResource PageSubtitle}" />

            <!-- 账号与顺序 -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,14">
                <StackPanel>
                    <TextBlock Text="账号与顺序" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="从第几个账号开始" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.StartAccountIndex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="序号更小的账号本次不登录（1 表示从第一个账号开始）"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="密码错误重试次数" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.MaxPasswordRetries, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="超过次数后自动换下一个账号登录"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 定时与关机 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="定时上号 / 定时下号" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="启用定时上号"
                                  IsChecked="{Binding Settings.ScheduledStartEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.ScheduledStartTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="24 小时制，格式 HH:mm，例如 08:00（允许 5 分钟误差）"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="启用定时下号"
                                  IsChecked="{Binding Settings.ScheduledStopEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.ScheduledStopTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="到点停止任务，并按下面的「票完动作」收尾（例如 00:05 停掉飞车）"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="全部完成自动关机"
                                  IsChecked="{Binding Settings.AutoShutdown, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.ShutdownDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="兼容旧配置：票完动作为「票完停止」时才走这里；已选关机／重启时以票完动作为准"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Button Content="取消关机倒计时"
                            Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left"
                            Command="{Binding CancelShutdownCommand}" />
                </StackPanel>
            </Border>

            <!-- 票完动作 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="票完动作（全部账号跑完后做什么）" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="票完动作" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FinishActionOptions}"
                                  SelectedItem="{Binding SelectedFinishAction, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  ItemContainerStyle="{StaticResource ComboItem}" />
                        <TextBlock Grid.Column="2"
                                   Text="全部账号跑完后的收尾动作：停止／小化／关机／重启／重爆"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="收尾倒计时（秒）" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.FinishActionDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="关机／重启前的等待时间，期间可以点「取消关机倒计时」反悔"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="重爆等待（秒）" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.RerunDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="没开定时上号时，票完重爆就是等这么多秒立刻重跑；开了定时上号则改为隔天到点重来"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 预设与开机 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="预设方案与开机自启" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="预设方案" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PresetNames}"
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  ItemContainerStyle="{StaticResource ComboItem}" />
                        <Button Grid.Column="2" Content="套用" Margin="8,0,0,0"
                                Command="{Binding ApplyPresetCommand}" />
                        <TextBlock Grid.Column="3"
                                   Text="一键套用玩法勾选、局数、并发与票完动作（常用／快捷／推荐设置2）"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="开机自动启动本程序"
                                  IsChecked="{Binding Settings.AutoStartWithWindows, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AutoStartEnabled, StringFormat=注册表状态：{0}}"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="刷新状态" HorizontalAlignment="Left"
                                Command="{Binding RefreshAutoStartCommand}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="启动后自动开始白票"
                                  IsChecked="{Binding Settings.AutoStartTaskOnLaunch, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="配合上面的开机自启使用：开机 → 自动开程序 → 自动开跑（无人值守）"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 性能与多开 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="性能与多开" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="登录后降低帧率"
                                  IsChecked="{Binding Settings.LowFrameRateEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.LowFrameRateTarget, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="每个登录的账号都会执行 flows/lower_fps.json 调整游戏内帧率"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="同时降低进程优先级"
                                  IsChecked="{Binding Settings.LowerProcessPriority, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="把游戏进程设为 BelowNormal，多开时减少 CPU 抢占"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最大同时登录数" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.MaxConcurrentInstances, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="组队玩法按需启动客户端，不会超过该数量"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 号池与容错 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="号池顶替与容错" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="号池顶替模式"
                                  IsChecked="{Binding Settings.PoolMode, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.MaxConcurrentInstances, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="同时挂 N 个号（N = 最大同时登录数），谁先跑完谁下号、号池补下一个顶上；关闭则按「逐个跑 + 组队分批」"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="顶号延迟（秒）" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.TopUpDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="一个号下号后等这么久再上另一个号，避免顶号冲突（顶号延迟）"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="掉线重连次数" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="72"
                                     Text="{Binding Settings.ReconnectMaxAttempts, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Width="72" Margin="8,0,0,0"
                                     Text="{Binding Settings.ReconnectDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="次 / 秒" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="中间是重连前等待秒数；玩法流程里用 expectNoImage 标 disconnected 即可触发"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="冻结 / 环境异常换号" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="72"
                                     Text="{Binding Settings.FreezeSwapThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Width="72" Margin="8,0,0,0"
                                     Text="{Binding Settings.EnvAbnormalSwapThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="次" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="左侧是「冻结提示几次换号」，右侧是「环境异常几次换号」"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="随机延时（毫秒）" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="72"
                                     Text="{Binding Settings.RandomDelayMinMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="~" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Width="72"
                                     Text="{Binding Settings.RandomDelayMaxMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="每次点击/按键额外叠加的随机抖动，0~0 表示不加；节奏太机械容易被判定"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 登录与大区 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="登录方式与大区" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="优先快速登录"
                                  IsChecked="{Binding Settings.FastLoginEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="复用 QQ 客户端的登录态点客户端头像进游戏，不输密码（需要 flows/login_fast.json 和对应模板）"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="登录前选择大区"
                                  IsChecked="{Binding Settings.SelectServerBeforeLogin, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="执行 flows/login_server.json 按大区点选；没有该流程时自动跳过"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="默认大区" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ServerOptions}"
                                  SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                                  ItemContainerStyle="{StaticResource ComboItem}" />
                        <TextBlock Grid.Column="2"
                                   Text="账号文本里写了区服时以账号为准，这里只做兜底"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 登录验证码（自动过码） -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="登录验证码（自动过码）" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="自动识别并点选"
                                  IsChecked="{Binding Settings.AutoCaptchaEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="登录弹出「QQ安全中心」图片验证码时，自动切图＋识别＋点选＋点确定；关闭或识别失败时改为等你手动完成"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="识别接口地址" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.CaptchaApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="OpenAI 兼容地址，程序会自动补 /chat/completions。默认智谱（长期免费）：https://open.bigmodel.cn/api/paas/v4"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="接口密钥" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.CaptchaApiKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="智谱 apiKey（bigmodel.cn 控制台获取）；魔搭填 ms- 开头的令牌；本地 Ollama 可留空（地址填 http://127.0.0.1:11434/v1）"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="模型名" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.CaptchaModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="必须支持图片输入。默认 glm-4.6v-flash（免费）；其他可用 glm-4v-flash、Qwen/Qwen3-VL-30B-A3B-Instruct 等"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="备用模型" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.CaptchaFallbackModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="主模型被限流（429）时改用它，留空则不降级。智谱各免费模型配额独立，默认 glm-4v-flash；换平台时记得清空"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最多尝试次数" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.CaptchaMaxAttempts, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="答错会换一张图，按这里的次数重试；用完仍不通过就转为人工"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="人工等待（秒）" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.CaptchaManualWaitSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="识别失败或没配密钥时，等你手动点完验证码的时间；期间验证码窗口消失就自动继续"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="窗口标题关键字" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.CaptchaWindowTitles, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="多个用竖线分隔；改标题或换客户端时，用「测试验证码识别」导出当前窗口标题来核对"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="记录 AI 调用日志"
                                  IsChecked="{Binding Settings.AiRequestLogEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="每次模型请求单独写一节：完整请求体、完整响应体、状态码、耗时，存到 User/log/ai/；请求里的图片另存在 media 子目录（日志保留 14 天，图片 7 天）"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="测试验证码识别（先让验证码弹出来）"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding TestCaptchaCommand}" />
                        <Button Content="打开 AI 日志目录"
                                Margin="10,0,0,0"
                                Command="{Binding OpenAiLogFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 客户端与窗口 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="客户端与窗口" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="游戏主程序 / 目录" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.GameExePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="选择 exe" Command="{Binding BrowseGameExeCommand}" Margin="8,0,0,0" />
                            <Button Content="选择目录" Command="{Binding ChooseGameFolderCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="键鼠输入通道" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding InputBackendOptions}"
                                  SelectedItem="{Binding SelectedInputBackend, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="选择 dll" Command="{Binding BrowseInterceptionDllCommand}" Margin="8,0,0,0" />
                            <Button Content="刷新状态" Command="{Binding RefreshInputBackendStatusCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding InputBackendStatus}"
                               Style="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               Margin="176,0,0,10" />

                    <TextBlock Style="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               Margin="176,0,0,10"
                               Text="驱动级输入需要先安装 Interception：以管理员运行 install-interception.exe /install 并重启，再把 interception.dll 放到程序目录（或点「选择 dll」指定）。装好后重启本程序，日志会显示「输入通道：Interception」。" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="窗口不足时自动启动"
                                  IsChecked="{Binding Settings.AutoLaunchGame, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.LaunchWaitSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="启动后等待窗口出现的秒数"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="进程名关键字" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.ProcessNameKeyword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="默认 QQSpeed，可填客户端实际进程名（不含 .exe）"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="窗口标题关键字" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.WindowTitleKeyword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="默认 QQ飞车，进程名或标题任一项匹配即接管"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="截图方式" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding CaptureModes}"
                                  SelectedItem="{Binding Settings.CaptureMode, Mode=TwoWay}"
                                  ItemContainerStyle="{StaticResource ComboItem}" />
                        <TextBlock Grid.Column="2"
                                   Text="多开卡顿时优先使用 BitBlt；画面抓不到再试 WindowsGraphicsCapture"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 操作节奏 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="操作节奏" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="操作间隔（毫秒）" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.ActionDelayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="按键、点击之间的等待，游戏响应慢时适当加大"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="激活窗口后等待" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.WindowActivateDelayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="多开切换前台焦点时的等待，避免输入丢到别的窗口"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="默认等待超时（秒）" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.FlowTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="等待模板出现的最长时间"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="奖励截图延迟（毫秒）" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.RewardScreenshotDelayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="2"
                                   Text="结算动画播完再截图，避免截到黑屏或过渡画面"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
