<UserControl x:Class="QQSpeedAssistant.Views.Pages.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,24,26,24">

            <TextBlock Text="账号管理" Style="{StaticResource PageTitle}" />
            <TextBlock Text="按「账号----密码----区服」批量导入，运行顺序即列表顺序，可用上移／下移调整"
                       Style="{StaticResource PageSubtitle}" />

            <!-- 批量导入 -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,14">
                <StackPanel>
                    <TextBlock Text="批量导入" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="每行一个账号，示例：2139444541----ds111200----电信区（也支持制表符或逗号分隔；区服只认电信区／联通区／电信2区，写「电信」「联通」「网通」会自动换算）"
                               Style="{StaticResource Muted}" />
                    <TextBox Text="{Binding ImportText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="112"
                             Margin="0,10,0,0"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             FontFamily="Consolas" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="导入账号" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" />
                        <Button Content="添加一行" Command="{Binding AddBlankCommand}" Margin="8,0,0,0" />
                        <Button Content="清空全部" Style="{StaticResource DangerButton}" Command="{Binding ClearAllCommand}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource Muted}"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 账号列表 -->
            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="账号列表" Style="{StaticResource SectionTitle}" Margin="0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center">
                            <Run Text="已启用" /><Run Text=" " /><Run Text="{Binding EnabledCount, Mode=OneWay}" /><Run Text=" 个" />
                        </TextBlock>
                    </Grid>

                    <!-- 表头 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="启用" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="1" Text="账号" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="2" Text="密码" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="3" Text="区服" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="5" Text="排序 / 删除" Style="{StaticResource Muted}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="155" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Account, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Margin="0,0,8,0" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Margin="0,0,8,0"
                                                 FontFamily="Consolas" />
                                        <ComboBox Grid.Column="3"
                                                  Margin="0,0,8,0"
                                                  ItemsSource="{Binding DataContext.ServerChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding Server, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemContainerStyle="{StaticResource ComboItem}"
                                                  ToolTip="区服只能是电信区／联通区／电信2区" />

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding StatusText, Mode=OneWay}"
                                                   Style="{StaticResource Muted}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding StatusText, Mode=OneWay}" />

                                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                                            <Button Content="上移"
                                                    Style="{StaticResource SmallButton}"
                                                    Margin="0"
                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="下移"
                                                    Style="{StaticResource SmallButton}"
                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除"
                                                    Style="{StaticResource SmallButton}"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="账号列表为空，请先在上方批量导入。" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Accounts.Count, Mode=OneWay}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
