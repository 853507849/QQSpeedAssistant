{
  "name": "退出登录流程",
  "description": "顺序跑号时把客户端退回登录界面，供下一个账号复用同一个窗口。未配置本流程时程序会改为另开客户端（受最大同时登录数限制）。",
  "_模板清单": [ "hall_setting_button", "setting_logout_button", "logout_confirm_button", "login_account_box" ],
  "steps": [
    { "type": "log", "text": "退出当前账号" },
    { "type": "clickImage", "template": "hall_setting_button", "threshold": 0.85, "timeoutMs": 15000 },
    { "type": "clickImage", "template": "setting_logout_button", "threshold": 0.85, "timeoutMs": 10000 },
    { "type": "clickImage", "template": "logout_confirm_button", "threshold": 0.85, "timeoutMs": 10000, "required": false },
    { "type": "expectImage", "template": "login_account_box", "threshold": 0.85, "timeoutMs": 60000, "failReason": "timeout" }
  ]
}
