{
  "name": "登录流程（键盘自动聚焦）",
  "description": "完全不点鼠标：模板只用来确定输入框位置和校验画面变化，输入靠键盘——先打一个探针字符看目标区域有没有变化，没变化就按 Tab 换下一个控件，找到焦点后再输入账号密码并回车。多屏、显示器缩放导致鼠标点击总偏移时用这套最稳。登录界面有「记住账号」时，账号框已填着同一个账号就跳过账号输入（skipIfAccountRemembered）。",
  "_模板清单": [ "login_account_box", "login_password_box", "login_button", "login_wrong_password", "hall_main" ],
  "steps": [
    { "type": "log", "text": "开始登录（键盘模式） {account}（{server}）" },
    { "type": "typeTextAutoFocus", "template": "login_account_box", "threshold": 0.85, "timeoutMs": 15000, "text": "{account}", "maxTabs": 5, "skipIfAccountRemembered": true, "failReason": "assert_failed" },
    { "type": "typeTextAutoFocus", "template": "login_password_box", "threshold": 0.85, "timeoutMs": 8000, "text": "{password}", "maxTabs": 5, "failReason": "assert_failed" },
    { "type": "key", "key": "Enter" },
    { "type": "wait", "timeoutMs": 600 },
    { "type": "expectNoImage", "template": "login_wrong_password", "threshold": 0.8, "timeoutMs": 6000, "failReason": "wrong_password", "required": false },
    { "type": "waitImageGone", "template": "login_button", "threshold": 0.85, "timeoutMs": 90000, "failReason": "timeout" },
    { "type": "waitImage", "template": "hall_main", "threshold": 0.8, "timeoutMs": 20000, "required": false }
  ]
}
