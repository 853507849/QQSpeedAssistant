{
  "name": "登录流程（鼠标点击版）",
  "description": "用模板匹配结果点击输入框后输入，关键步骤带点击/输入自检。适合单屏、100% 缩放、鼠标定位精确的环境；多屏或高缩放环境请用默认的键盘模式 login.json。",
  "_模板清单": [ "login_account_box", "login_password_box", "login_button", "login_wrong_password", "hall_main" ],
  "steps": [
    { "type": "log", "text": "开始登录（鼠标模式） {account}（{server}）" },
    { "type": "clickImage", "template": "login_account_box", "threshold": 0.85, "timeoutMs": 15000, "failReason": "assert_failed", "verify": true, "verifyAttempts": 2 },
    { "type": "wait", "timeoutMs": 400 },
    { "type": "clearText" },
    { "type": "typeText", "text": "{account}", "verify": true },
    { "type": "clickImage", "template": "login_password_box", "threshold": 0.85, "timeoutMs": 10000, "verify": true, "verifyAttempts": 2 },
    { "type": "wait", "timeoutMs": 400 },
    { "type": "clearText" },
    { "type": "typeText", "text": "{password}", "verify": true },
    { "type": "clickImage", "template": "login_button", "threshold": 0.85, "timeoutMs": 10000, "verify": true, "verifyAttempts": 2, "key": "Enter" },
    { "type": "wait", "timeoutMs": 400 },
    { "type": "expectNoImage", "template": "login_wrong_password", "threshold": 0.8, "timeoutMs": 6000, "failReason": "wrong_password", "required": false },
    { "type": "waitImageGone", "template": "login_button", "threshold": 0.85, "timeoutMs": 90000, "failReason": "timeout" },
    { "type": "waitImage", "template": "hall_main", "threshold": 0.8, "timeoutMs": 20000, "required": false }
  ]
}
