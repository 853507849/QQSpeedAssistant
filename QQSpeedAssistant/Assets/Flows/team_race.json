{
  "name": "组队竞速（房主流程示例）",
  "description": "多人玩法中第一个登录的账号执行本流程（房主）：创建房间 → 设置模式 → 等待队员 → 开始。队员执行 team_race.member.json。流程里可以用 {role} 变量在日志中区分身份。",
  "_模板清单": [ "hall_multiplayer", "hall_create_room", "room_mode_team_race", "room_start_button", "race_finish_panel" ],
  "steps": [
    { "type": "log", "text": "第 {round} 局：组队竞速（{role}）" },
    { "type": "clickImage", "template": "hall_multiplayer", "threshold": 0.85, "timeoutMs": 15000 },
    { "type": "clickImage", "template": "hall_create_room", "threshold": 0.85, "timeoutMs": 10000 },
    { "type": "clickImage", "template": "room_mode_team_race", "threshold": 0.85, "timeoutMs": 10000 },
    { "type": "wait", "timeoutMs": 6000 },
    { "type": "clickImage", "template": "room_start_button", "threshold": 0.85, "timeoutMs": 15000 },
    { "type": "expectImage", "template": "race_finish_panel", "threshold": 0.8, "timeoutMs": 300000, "failReason": "timeout" },
    { "type": "saveReward" },
    { "type": "wait", "timeoutMs": 3000 }
  ]
}
